# Gemini API key: local development only. On Netlify, set this in Site/Project Environment Variables.
# Never expose this key in frontend code or commit a real key to Git.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional public site URL. Not required for Netlify Functions API routing.
APP_URL="https://YOUR-SITE.netlify.app"

# Optional model identifier. gemini-3.8-flash is listed in the current Gemini API model catalog.
GEMINI_MODEL="gemini-3.8-flash"
