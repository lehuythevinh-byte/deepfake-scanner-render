# GEMINI_API_KEY: Tùy chọn; cấu hình ít nhất một trong ba API key Gemini/OpenAI/DeepSeek
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Multi-AI failover ---
# Mỗi key nhập một lần trong Render Environment. Mỗi request chỉ gọi MỘT AI;
# khi nhà cung cấp lỗi/quá tải sẽ tự chuyển sang nhà cung cấp kế tiếp.
# Thứ tự ưu tiên mặc định: Gemini -> OpenAI -> DeepSeek.
AI_PROVIDER_ORDER="gemini,openai,deepseek"
AI_PROVIDER_COOLDOWN_MS=90000
AI_QUOTA_COOLDOWN_MS=900000
AI_REQUEST_TIMEOUT_MS=30000

# OpenAI (tùy chọn; cấu hình key một lần để dùng làm dự phòng)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-6.1-terra"
OPENAI_WEB_SEARCH_MODEL="gpt-6.1-terra"
# OPENAI_BASE_URL="https://api.openai.com/v1"

# DeepSeek (tùy chọn; cấu hình key một lần để dùng làm dự phòng)
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-flash"
# DEEPSEEK_BASE_URL="https://api.deepseek.com"

# APP_URL: URL máy chủ đang chạy
APP_URL="MY_APP_URL"

# Model mặc định của Gemini (nếu Gemini là provider đang được chọn)
GEMINI_MODEL="gemini-3.1-flash-lite"
# Tìm nguồn web và tạo bộ tình huống mới (mặc định 45 giây)
THREAT_INTELLIGENCE_TIMEOUT_MS=45000

# Hệ thống Quản trị & Tài khoản Người dùng (Tùy chọn - Cấu hình khi có PostgreSQL):
# Cung cấp Internal Database URL từ Render PostgreSQL (hoặc Supabase/Neon/Cloud SQL)
DATABASE_URL=

# Khởi tạo quản trị viên đầu tiên (Mật khẩu ít nhất 12 ký tự):
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Tắt SSL nếu dùng PostgreSQL nội bộ trên máy local (không dùng trên Render production)
# DATABASE_SSL=disable

# --- Khảo sát chất lượng bằng sao (tùy chọn; có giá trị mặc định) ---
# Số tác vụ hoàn tất để đủ điều kiện mời đánh giá (mặc định 5)
# SURVEY_MIN_TASKS=5
# Hoặc số ngày sử dụng (kèm ít nhất 1 tác vụ) (mặc định 7)
# SURVEY_MIN_DAYS=7
# "Để sau": hoãn bao nhiêu ngày (mặc định 3)
# SURVEY_SNOOZE_DAYS=3
# "Không phải lúc này": hoãn bao nhiêu ngày (mặc định 30)
# SURVEY_DISMISS_DAYS=30
# Sau khi gửi đánh giá, không mời lại trong bao nhiêu ngày (tối thiểu 30)
# SURVEY_COOLDOWN_DAYS=30
