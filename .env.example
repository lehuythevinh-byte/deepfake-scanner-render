# Gemini API key: local development only. On Render, set GEMINI_API_KEY in the service Environment tab.
# Never expose this key in frontend code or commit a real key to Git.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional public URL of the deployed Render web service.
APP_URL="https://YOUR-SERVICE.onrender.com"

# Optional model identifier. gemini-3.8-flash is listed in the current Gemini API model catalog.
GEMINI_MODEL="gemini-3.8-flash"
