# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Multi-provider AI failover. Any provider not configured is skipped.
AI_PROVIDER_ORDER=gemini,openrouter,openai,deepseek
AI_PROVIDER_COOLDOWN_MS=90000
AI_QUOTA_COOLDOWN_MS=900000
AI_REQUEST_TIMEOUT_MS=30000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL=google/gemma-4-31b-it:free
OPENROUTER_IMAGE_MODEL=google/gemma-4-31b-it:free
OPENROUTER_DAILY_COOLDOWN_MS=86400000

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6.1-terra
OPENAI_WEB_SEARCH_MODEL=gpt-6.1-terra

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Supabase/PostgreSQL. Use the connection string for the intended environment.
DATABASE_URL=
# Optional: path to the Supabase root CA bundle copied locally from your provider.
DATABASE_SSL_CA_FILE=
# Do not disable certificate validation in production.
# DATABASE_SSL=disable

# First administrator bootstrap. Use a unique password (at least 12 characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Generate a random secret with at least 32 characters and set the SAME value
# in the Render Environment and GitHub repository secret.
THREAT_INTELLIGENCE_CRON_SECRET=
THREAT_INTELLIGENCE_TIMEOUT_MS=45000
